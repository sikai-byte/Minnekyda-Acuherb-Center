generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRACTITIONER
  FRONT_DESK
  /// A patient's own portal login. Always bound to exactly one `Patient` through
  /// `User.patientId`, and never granted anything outside `/portal`.
  PATIENT
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

/// One row per authentication attempt, used both for throttling and for the
/// login-monitoring evidence HIPAA §164.308(a)(5)(ii)(C) expects.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

enum AppointmentStatus {
  /// Asked for through the public website by a stranger and not yet confirmed by the front
  /// desk. It holds capacity like any other appointment; what it does not hold is a verified
  /// identity.
  REQUESTED
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// What happened to an appointment. Every one of these is written once and never updated, so
/// an admin can reconstruct who moved a visit and when even after it was moved again.
enum AppointmentEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  ROOM_CHANGED
  PRACTITIONER_CHANGED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  STAFF
  /// The patient's own portal login.
  PORTAL
  /// The public website, by someone who may not have a chart yet.
  PUBLIC
}

enum IntakeStatus {
  IN_PROGRESS
  SUBMITTED
}

enum NoteStatus {
  DRAFT
  SIGNED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(FRONT_DESK)
  credentials    String?
  active         Boolean   @default(true)
  lastLoginAt    DateTime?
  /// TOTP shared secret. Present once enrolment starts; MFA is only in force once
  /// mfaEnabledAt is set, so a half-finished enrolment can't lock anyone out.
  mfaSecret      String?
  mfaEnabledAt   DateTime?
  /// bcrypt hashes of single-use recovery codes.
  mfaRecoveryCodes String[] @default([])
  /// Set on seeded and admin-reset accounts so the first login must choose a new password.
  mustChangePassword Boolean @default(false)
  /// Set only on PATIENT accounts, and it is the sole source of the patient identity the
  /// portal reads: no portal query ever takes a patient id from the request.
  patientId      String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notes          ClinicalNote[] @relation("NoteAuthor")
  startedIntakes IntakeSubmission[] @relation("IntakeStartedBy")
  auditLogs      AuditLog[]
  availability   PractitionerAvailability[] @relation("PractitionerAvailability")
  timeOff        ClinicClosure[] @relation("PractitionerTimeOff")
  appointments   Appointment[] @relation("PractitionerAppointments")
  bookedAppointments Appointment[] @relation("AppointmentCreatedBy")
  appointmentEvents  AppointmentEvent[] @relation("AppointmentEventActor")
  patient        Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Patient {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  sex                Sex       @default(UNDISCLOSED)
  phone              String?
  email              String?
  streetAddress      String?
  city               String?
  state              String?
  zip                String?
  occupation         String?
  primaryPhysician   String?
  emergencyName      String?
  emergencyPhone     String?
  archivedAt         DateTime?
  /// Set when the chart was created by someone booking on the public website rather than by
  /// staff, so the front desk knows the identity is unverified and may be a duplicate.
  selfRegisteredAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  intakes            IntakeSubmission[]
  notes              ClinicalNote[]
  appointments       Appointment[]
  portalAccount      User?

  @@index([lastName, firstName])
}

/// What a visit is and how long it takes. The clinic's own rules are 60 minutes for a treatment
/// and 75 for a first consultation plus treatment. Duration lives here and nowhere else: no
/// caller may pass a length, so a browser cannot ask for a 15-minute new-patient consultation.
model AppointmentType {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  minutes          Int
  /// Offered on the public website. First-visit types are the only ones a stranger may book;
  /// everything else is portal or front desk.
  publiclyBookable Boolean  @default(false)
  firstVisit       Boolean  @default(false)
  /// The minutes at the start and at the end of the visit that need the practitioner in the
  /// room: 15 and 15 for a treatment, 30 and 15 for a first consultation. The stretch between
  /// them is retention, when the practitioner can be starting another patient, and it is what
  /// makes the clinic's quarter-hour staggering work. Null on both counts the whole visit.
  practitionerLeadMinutes  Int?
  practitionerCloseMinutes Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  appointments     Appointment[]

  @@index([active])
}

/// A physical treatment room. Room occupancy and practitioner capacity are separate limits:
/// five rooms is how many patients can be on tables at once, which is not the same question as
/// how many a practitioner can be responsible for.
model TreatmentRoom {
  id           String   @id @default(cuid())
  name         String   @unique
  /// Rooms are ordered, not sorted by name, so "Room 10" does not come before "Room 2" and the
  /// front desk always sees the day in the same column order.
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  appointments Appointment[]

  @@index([active, position])
}

/// The clinic's scheduling rules, as data rather than constants so they can be changed without
/// a deploy. One row, `id = "default"`.
///
/// `maxConcurrentPerPractitioner` is 1 because a practitioner cannot be in two rooms at once.
/// Overlap comes from `AppointmentType`'s active phases instead: a practitioner is free during
/// another patient's retention, so quarter-hour starts fit under a limit of one.
model SchedulingPolicy {
  id                           String   @id @default("default")
  maxConcurrentPerPractitioner Int      @default(1)
  slotStepMinutes              Int      @default(15)
  /// How much warning a patient booking themselves has to give, and how much notice they must
  /// give to cancel or move a visit without phoning.
  selfBookingNoticeMinutes     Int      @default(120)
  selfCancelNoticeHours        Int      @default(24)
  selfRescheduleNoticeHours    Int      @default(48)
  bookingHorizonDays           Int      @default(60)
  /// Website requests are confirmed as they are made. When false they land as REQUESTED,
  /// holding the room until the front desk confirms them.
  publicRequestsAutoConfirm    Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

/// The weekly template of when a practitioner sees patients. Times are minutes from midnight
/// in the clinic's timezone, which keeps the arithmetic free of daylight-saving surprises.
model PractitionerAvailability {
  id             String @id @default(cuid())
  practitionerId String
  weekday        Int
  startMinute    Int
  endMinute      Int

  practitioner   User   @relation("PractitionerAvailability", fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId, weekday])
}

/// A closure: vacation, a meeting, a public holiday. `label` is staff-facing scheduling
/// language only — never a patient's reason for anything.
model ClinicClosure {
  id             String   @id @default(cuid())
  /// Null closes the whole clinic.
  practitionerId String?
  startsAt       DateTime
  endsAt         DateTime
  label          String?
  createdAt      DateTime @default(now())

  practitioner   User?    @relation("PractitionerTimeOff", fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@index([practitionerId, startsAt])
}

/// Scheduling logistics only. There is deliberately no complaint, reason, symptom or comment
/// column here: the calendar is the least protected surface in the product — it is read by
/// the front desk all day and partly authored by the public booking form — so no health
/// information is allowed to enter it. Clinical content lives in `ClinicalNote`, which
/// front desk staff cannot open, and `scheduling.test.ts` fails the build if a free-text
/// column appears on this model.
model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  practitionerId    String
  appointmentTypeId String
  roomId            String?
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus @default(SCHEDULED)
  source            BookingSource     @default(STAFF)
  createdById       String?
  checkedInAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  noShowAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    User              @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  appointmentType AppointmentType   @relation(fields: [appointmentTypeId], references: [id])
  room            TreatmentRoom?    @relation(fields: [roomId], references: [id])
  createdBy       User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  events          AppointmentEvent[]
  notes           ClinicalNote[]

  /// The day views and the availability query are all date-range reads filtered by room,
  /// practitioner or status, and they are the queries that have to stay fast as the table grows
  /// past ten thousand visits.
  @@index([startsAt])
  @@index([practitionerId, startsAt])
  @@index([patientId, startsAt])
  @@index([roomId, startsAt])
  @@index([status, startsAt])
}

/// The appointment's history, append-only. Nothing here is ever updated or deleted, including
/// for a cancelled visit: what the front desk did and when is the record that answers a dispute
/// about a missed appointment or a late cancellation fee.
///
/// Changes are recorded as typed columns rather than a free-text description, so the history is
/// queryable and cannot become a place someone writes a sentence about a patient.
model AppointmentEvent {
  id                 String               @id @default(cuid())
  appointmentId      String
  type               AppointmentEventType
  /// Null for the public website, where nobody is signed in.
  actorId            String?
  actorRole          Role?
  source             BookingSource?
  fromStatus         AppointmentStatus?
  toStatus           AppointmentStatus?
  fromStartsAt       DateTime?
  toStartsAt         DateTime?
  fromRoomId         String?
  toRoomId           String?
  fromPractitionerId String?
  toPractitionerId   String?
  createdAt          DateTime             @default(now())

  appointment        Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor              User?                @relation("AppointmentEventActor", fields: [actorId], references: [id])

  @@index([appointmentId, createdAt])
  @@index([createdAt])
}

/// One row per public booking submission, so the open form can be throttled per source
/// address without reaching into the appointment table. Contact details stay on the chart.
model BookingAttempt {
  id        String   @id @default(cuid())
  ip        String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// The measurements the clinic wants to prove: how long paperwork takes, how long a note takes,
/// how full the rooms are, how much front-desk time the platform gives back. Most of those are
/// durations between two moments, and a duration cannot be reconstructed after the fact, so the
/// moments are recorded as they happen.
enum ClinicEventType {
  INTAKE_STARTED
  INTAKE_SUBMITTED
  /// The practitioner opened a blank or draft note. There is no note row yet at that point,
  /// which is why the moment needs recording here.
  NOTE_STARTED
  NOTE_SIGNED
  APPOINTMENT_BOOKED
  APPOINTMENT_CHECKED_IN
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
}

/// Timing telemetry, deliberately separate from `AuditLog`: the audit trail answers "who saw
/// this chart" and must never be pruned, while these rows are aggregate operations data.
///
/// Carries identifiers and durations only — no answers, no note text, no free text of any kind,
/// and no foreign keys, so a chart can be deleted for retention without erasing the clinic's
/// operating history. `ClinicEvent` is the only table in the schema that outlives a patient row,
/// and it can do that precisely because there is nothing clinical in it.
model ClinicEvent {
  id             String          @id @default(cuid())
  type           ClinicEventType
  occurredAt     DateTime        @default(now())
  /// Set when the event closes an interval the clinic wants to measure, so the reports do not
  /// have to re-pair rows at read time.
  durationMs     Int?
  patientId      String?
  userId         String?
  appointmentId  String?
  submissionId   String?
  noteId         String?
  appointmentTypeId String?
  roomId         String?
  /// Which door a booking came through, which is what turns into front-desk minutes saved.
  source         BookingSource?
  /// The visit's scheduled length, copied in so utilisation can be totalled from events alone
  /// even after a service is renamed or retired.
  minutes        Int?

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([patientId, occurredAt])
}

/// A versioned intake questionnaire. Editing a live form creates a new version
/// so that historical submissions always render against the schema they were signed under.
model IntakeForm {
  id          String   @id @default(cuid())
  slug        String
  version     Int
  title       String
  schemaJson  Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  submissions IntakeSubmission[]

  @@unique([slug, version])
}

model IntakeSubmission {
  id            String       @id @default(cuid())
  patientId     String
  intakeFormId  String
  /// Staff member who handed the iPad to the patient. The patient submits the form
  /// themselves, so this is who the submission is attributed to in the audit log.
  startedById   String?
  status        IntakeStatus @default(IN_PROGRESS)
  answersJson   Json         @default("{}")
  signatures    Json         @default("{}")
  submittedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  form          IntakeForm   @relation(fields: [intakeFormId], references: [id])
  startedBy     User?        @relation("IntakeStartedBy", fields: [startedById], references: [id])

  @@index([patientId, createdAt])
}

model NoteTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  fieldsJson  Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  notes       ClinicalNote[]
}

/// Clinical notes are immutable once signed. An amendment is a new row pointing at
/// the note it supersedes via `amendsId`, so the full history is always recoverable.
model ClinicalNote {
  id             String       @id @default(cuid())
  patientId      String
  authorId       String
  templateId     String?
  /// The visit this note documents, when it was started from the schedule. Optional because a
  /// note may be written for a walk-in or a phone consultation that never had an appointment,
  /// and because notes predating scheduling have none. Not unique: an amendment is a second
  /// note about the same visit.
  appointmentId  String?
  visitDate      DateTime
  status         NoteStatus   @default(DRAFT)
  chiefComplaint String?
  subjective     String?
  objective      String?
  tcmDiagnosis   String?
  assessment     String?
  plan           String?
  pointsUsed     String?
  herbFormula    String?
  fieldsJson     Json         @default("{}")
  signedAt       DateTime?
  amendsId       String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id])
  template       NoteTemplate? @relation(fields: [templateId], references: [id])
  amends         ClinicalNote? @relation("Amendment", fields: [amendsId], references: [id])
  amendedBy      ClinicalNote? @relation("Amendment")
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])

  @@index([patientId, visitDate])
  @@index([appointmentId])
}

/// Every read and write of patient data is recorded. Required for HIPAA audit controls.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  patientId  String?
  detail     Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([patientId, createdAt])
  @@index([createdAt])
}
