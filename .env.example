# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/minnekyda?schema=public"

# Throwaway database Prisma builds and drops when comparing migrations (`npm run db:drift`).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:55433/minnekyda_shadow?schema=public"

# 32+ character secret used to encrypt the session cookie
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# 32-byte base64 key encrypting stored TOTP secrets (`openssl rand -base64 32`).
# In production this holds a data key decrypted from Cloud KMS at boot. Falls back to a key
# derived from SESSION_SECRET when unset, which is fine for local/synthetic data only.
MFA_ENCRYPTION_KEY=""

# The clinic's wall clock. Every "nine o'clock" and every calendar day means this zone;
# instants are still stored in UTC. Defaults to America/Chicago.
CLINIC_TIME_ZONE="America/Chicago"

# Set to "true" only behind HTTPS (production)
SECURE_COOKIES="false"

# Transactional email (Resend). With RESEND_API_KEY or EMAIL_FROM unset the app runs normally
# and sends nothing — every attempt is recorded as SKIPPED — which is how local development and
# any synthetic environment should behave.
#
# EMAIL_FROM must be an address on a domain verified in Resend (SPF + DKIM records added to the
# clinic's DNS), or mail is refused or filed as spam.
RESEND_API_KEY=""
EMAIL_FROM="Minnekyda Acuherb Center <appointments@minnekyda.com>"
EMAIL_REPLY_TO=""

# Used to build the links in emails. Must be the public origin, with no trailing slash.
APP_BASE_URL="http://localhost:3000"

# Shown in emails so a patient can reach the clinic without hunting for the number.
CLINIC_NAME="Minnekyda Acuherb Center"
CLINIC_PHONE=""

# How far ahead `npm run reminders` looks for visits to remind, in hours. Defaults to 36.
REMINDER_HOURS_AHEAD=""
