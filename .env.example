# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/minnekyda?schema=public"

# 32+ character secret used to encrypt the session cookie
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# 32-byte base64 key encrypting stored TOTP secrets (`openssl rand -base64 32`).
# In production this holds a data key decrypted from Cloud KMS at boot. Falls back to a key
# derived from SESSION_SECRET when unset, which is fine for local/synthetic data only.
MFA_ENCRYPTION_KEY=""

# Set to "true" only behind HTTPS (production)
SECURE_COOKIES="false"
